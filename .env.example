# Your Neon Postgres connection string (get this from neon.tech dashboard)
DATABASE_URL=postgres://user:password@ep-something.neon.tech/neondb?sslmode=require

# Any long random string, used to sign login tokens
JWT_SECRET=replace-this-with-a-long-random-string

# The full base URL of your deployed site (used to build short links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
